# Copy this file to .env.local and fill in your Stripe key.
# .env.local is git-ignored — NEVER commit real keys.

# Stripe secret key (server-side only). Use a TEST key (sk_test_...) while
# developing, then a LIVE key (sk_live_...) in production.
# Find it at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here

# Stripe webhook signing secret (whsec_...), used to verify /api/webhook calls.
# Local: run `stripe listen --forward-to localhost:3000/api/webhook` — the CLI
#   prints a whsec_... to paste here.
# Production: create the endpoint at https://dashboard.stripe.com/webhooks
#   (URL: https://YOUR_DOMAIN/api/webhook) and copy its signing secret.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
