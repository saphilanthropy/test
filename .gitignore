# Installed dependencies. package.json and package-lock.json record what is needed.
node_modules/

# Rendered carousels are build artefacts — the deck .md is the source of truth
# and regenerates them. Keeping PDFs and PNGs in git just bloats the history.
linkedin/carousel/*.pdf
linkedin/carousel/previews/

# Deck QA intermediates: regenerate with `bash decks/qa.sh`. The .pptx itself is
# kept, since that is the deliverable people actually open.
decks/*.pdf
decks/slide-*.png
